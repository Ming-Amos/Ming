# Ming Stage B — 本地服务端配置示例
# 复制此文件为 apps/server/.env，填入真实值，不要提交 .env 到版本库。
# .env 已在 .gitignore 中列出；本文件 (.env.example) 可以提交。

# ── 模型提供商配置 ──────────────────────────────────────────────────
# 提供商标签（仅用于展示，不影响逻辑）
PROVIDER_LABEL=my-model-provider

# 兼容 Chat Completions API 的根路径，含版本路径前缀，末尾无斜杠。
# 请使用所选服务商文档提供的 API root；也可使用实现相同协议的本地服务。
# 服务端会拼接 /chat/completions，请不要在此处重复添加端点路径。
PROVIDER_BASE_URL=https://your-provider-api-root/v1

# 模型 ID（由用户根据所选服务商自行填写，不硬编码默认值）
PROVIDER_MODEL_ID=your-model-id

# API 密钥（仅保存在本机服务端，绝不发送到前端或写入日志/证据/截图）
PROVIDER_API_KEY=your-api-key-here

# ── 如何添加其他协议的提供商适配器 ──────────────────────────────────
# 当前仅实现兼容 Chat Completions API 的 HTTP 传输。
# 若要添加其他协议，步骤如下：
#   1. 在 apps/server/src/provider/ 下新建 <name>-transport.ts，
#      实现 ProviderTransport 接口（见 provider/types.ts）。
#   2. 在 provider/index.ts 中的 createTransport() 工厂函数加入对应的
#      PROVIDER_PROTOCOL 环境变量分支，返回新的传输实例。
#   3. 在本 .env.example 中加入新协议所需的环境变量说明。
#   4. 运行 pnpm build 并补充对应的传输集成测试（scripts/run-stage-b-transport-tests.mjs）。
